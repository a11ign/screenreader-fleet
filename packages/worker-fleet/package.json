{
  "name": "@a11y-witness/worker-fleet",
  "version": "0.1.0",
  "description": "Host-side lifecycle, health and capacity for a fleet of Windows NVDA capture workers: lease one, judge whether it is degrading, and know how many the host can afford.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./health": {
      "default": "./dist/worker-health.mjs"
    },
    "./capacity": {
      "default": "./dist/host-capacity.mjs"
    },
    "./worker-http": {
      "types": "./dist/worker-http.d.mts",
      "default": "./dist/worker-http.mjs"
    },
    "./cli-flags": {
      "default": "./dist/cli-flags.mjs"
    },
    "./transient-fault": {
      "types": "./dist/transient-fault.d.mts",
      "default": "./dist/transient-fault.mjs"
    },
    "./capture-client": {
      "types": "./dist/capture-client.d.mts",
      "default": "./dist/capture-client.mjs"
    },
    "./host-address": {
      "types": "./dist/host-address.d.mts",
      "default": "./dist/host-address.mjs"
    },
    "./fleet-env": {
      "types": "./dist/fleet-env.d.mts",
      "default": "./dist/fleet-env.mjs"
    },
    "./fleet-consistency": {
      "types": "./dist/fleet-consistency.d.mts",
      "default": "./dist/fleet-consistency.mjs"
    },
    "./worker-code-check": {
      "types": "./dist/worker-code-check.d.mts",
      "default": "./dist/worker-code-check.mjs"
    }
  },
  "bin": {
    "a11y-doctor": "./dist/doctor.mjs",
    "a11y-worker-code": "./dist/check-worker-code.mjs",
    "a11y-worker-compare": "./dist/compare-workers.mjs",
    "a11y-worker-ctl": "./src/local-worker/worker-ctl.sh",
    "a11y-worker-deploy": "./dist/deploy-worker.mjs"
  },
  "files": [
    "dist",
    "src/local-worker",
    "src/provisioning",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@a11y-witness/nvda-worker": "0.1.0"
  },
  "devDependencies": {
    "@a11y-witness/evidence": "0.1.0",
    "yaml": "^2.9.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "tsc --build",
    "prepare": "tsc --build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanBeckDev/a11y-witness.git",
    "directory": "packages/worker-fleet"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "nvda",
    "screen-reader",
    "windows",
    "utm",
    "vm"
  ]
}
