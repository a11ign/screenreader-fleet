{
  // What Rslib reads to lay out and declare the package: its own `src` and no test. The ROOT `tsconfig.json` is the typecheck (`tsc --noEmit`,
  // tests and `scripts/` included); Rslib builds, `tsc` here emits nothing.
  "extends": "@a11ign/toolchain/tsconfig.base.json",
  // `@a11ign/screenreader-worker` ships `.mjs` with `.d.mts` beside it only from its next release; until then the compiler reads the JS it
  // ships (a module and what it imports), and nothing in `node_modules` is emitted.
  "compilerOptions": { "rootDir": "src", "noEmit": true, "maxNodeModuleJsDepth": 2 },
  // The `.mjs` here are host-side and ship as built modules beside the compiled TS; `allowJs` without `checkJs` reads them without
  // type-checking.
  "include": ["src/**/*.ts", "src/**/*.mjs"],
  "exclude": ["src/**/*.test.ts"]
}
