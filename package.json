{
  "name": "@a11ign/screenreader-fleet",
  "version": "0.7.1",
  "description": "Host-side lifecycle, health and capacity for a fleet of Windows NVDA capture workers: lease one, judge whether it is degrading, and know how many the host can afford.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./health": {
      "types": "./dist/worker-health.d.ts",
      "default": "./dist/worker-health.mjs"
    },
    "./capacity": {
      "types": "./dist/host-capacity.d.ts",
      "default": "./dist/host-capacity.mjs"
    },
    "./probe-outcome": {
      "types": "./dist/probe-outcome.d.ts",
      "default": "./dist/probe-outcome.mjs"
    },
    "./worker-http": {
      "types": "./dist/worker-http.d.ts",
      "default": "./dist/worker-http.mjs"
    },
    "./cli-flags": {
      "types": "./dist/cli-flags.d.ts",
      "default": "./dist/cli-flags.mjs"
    },
    "./transient-fault": {
      "types": "./dist/transient-fault.d.ts",
      "default": "./dist/transient-fault.mjs"
    },
    "./capture-client": {
      "types": "./dist/capture-client.d.ts",
      "default": "./dist/capture-client.mjs"
    },
    "./host-address": {
      "types": "./dist/host-address.d.ts",
      "default": "./dist/host-address.mjs"
    },
    "./fleet-env": {
      "types": "./dist/fleet-env.d.ts",
      "default": "./dist/fleet-env.mjs"
    },
    "./fleet-consistency": {
      "types": "./dist/fleet-consistency.d.ts",
      "default": "./dist/fleet-consistency.mjs"
    },
    "./worker-code-check": {
      "types": "./dist/worker-code-check.d.ts",
      "default": "./dist/worker-code-check.mjs"
    }
  },
  "bin": {
    "a11ign-doctor": "./dist/doctor.mjs",
    "a11ign-worker-code": "./dist/check-worker-code.mjs",
    "a11ign-worker-compare": "./dist/compare-workers.mjs",
    "a11ign-worker-ctl": "./src/local-worker/worker-ctl.sh"
  },
  "files": [
    "dist",
    "src/local-worker",
    "src/provisioning",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@a11ign/judge": "0.5.1",
    "@a11ign/screenreader-worker": "0.9.0",
    "@a11ign/toolchain": "0.5.0"
  },
  "devDependencies": {
    "@a11ign/evidence": "0.3.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^10.0.1",
    "@rslib/core": "1.0.3",
    "@rstest/core": "0.12.3",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "prepack": "rslib build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "rstest run"
  },
  "homepage": "https://github.com/a11ign/screenreader-fleet",
  "keywords": [
    "accessibility",
    "a11y",
    "nvda",
    "screen-reader",
    "windows",
    "utm",
    "vm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/screenreader-fleet.git"
  },
  "packageManager": "pnpm@10.34.5"
}
