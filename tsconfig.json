{
  // Type-checks the `.ts` tests and, through `allowJs`, whatever they import. The program is `noEmit`: nothing here is built by it, and the
  // package's published files are `src` as written; `tsconfig.build.json` is what Rslib reads.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    // The sources are `.ts` and import each other as `./x.ts`; Node strips the types of the subset below, and this lets the checker accept the extension (TS5097).
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    // The published `@a11ign/screenreader-worker` ships `.mjs` with no declarations: read the JS it ships (see tsconfig.build.json).
    "maxNodeModuleJsDepth": 2
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
